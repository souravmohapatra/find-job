              {
                "type": "null"
              }
            ],
            "title": "Operation Id"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
