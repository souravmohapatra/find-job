              "capability",
              "seniority",
              "employment",
              "location",
              "remote",
              "compensation",
              "other"
            ],
            "title": "Kind"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description"
          },
          "strength": {
            "type": "string",
            "enum": ["preferred", "required"],
            "title": "Strength",
            "default": "preferred"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "kind", "description"],
        "title": "Criterion"
      },
