# Copy to deploy/.env (ignored). Use only non-secret deployment parameters here.
# Replace with this server's actual RFC1918 LAN address and local DNS hostname.
LAN_IP=192.168.1.20
LAN_HOST=jobs.home.arpa
TAILNET_HOST=jobs.example-tailnet.ts.net
# External shared ntfy server configuration:
NTFY_NETWORK=ntfy_default
JOBFINDER_NTFY_URL=http://ntfy:80
APP_LOOPBACK_PORT=8085
NOTIFY_LOOPBACK_PORT=8086
NTFY_TOPIC=jobfinder
INTEGRATION_MODE=mock
SEARCH_MODE=mock
NOTIFICATION_MODE=mock
# Snap Docker only: set false to enable NNP inside setpriv after AppArmor attachment.
# Leave true on compatible Docker runtimes. Other isolation controls remain unchanged.
DOCKER_NO_NEW_PRIVILEGES=true
# Set true only after scripts/test-fetch-isolation.py passes on this host:
FETCH_ISOLATION_VERIFIED=false
